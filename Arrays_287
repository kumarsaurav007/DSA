# Maximum Score of Non-overlapping Intervals :-

def maximumWeight(self, intervals: List[List[int]]) -> List[int]:
        n = len(intervals)

        # (start, end, weight, original_index)
        arr = sorted(
            (l, r, w, i)
            for i, (l, r, w) in enumerate(intervals)
        )

        starts = [x[0] for x in arr]

        # First interval whose start > current end
        nxt = [bisect_right(starts, arr[i][1]) for i in range(n)]

        # dp[k][i] = best result using at most k intervals
        # from i onward
        dp = [[(0, ()) for _ in range(n + 1)] for _ in range(5)]

        for k in range(1, 5):
            for i in range(n - 1, -1, -1):

                # Don't take current interval
                skip = dp[k][i + 1]

                # Take current interval
                j = nxt[i]
                take_score = arr[i][2] + dp[k - 1][j][0]

                take_indices = tuple(
                    sorted((arr[i][3],) + dp[k - 1][j][1])
                )

                take = (take_score, take_indices)

                # Maximum score first
                if take[0] > skip[0]:
                    dp[k][i] = take

                # Lexicographically smaller indices on tie
                elif take[0] < skip[0]:
                    dp[k][i] = skip

                else:
                    dp[k][i] = min(skip, take)

        return list(dp[4][0][1])

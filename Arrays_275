# Find the Largest Almost Missing Integer :-

def largestInteger(self, nums: List[int], k: int) -> int:
        n = len(nums)

        count = [0] * 51

        # For every subarray of size k
        for i in range(n - k + 1):
            seen = set()

            for j in range(i, i + k):
                seen.add(nums[j])

            for x in seen:
                count[x] += 1

        ans = -1

        for x in range(51):
            if count[x] == 1:
                ans = x

        return ans

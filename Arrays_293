# Find X Value of Array II :-

class Solution:
    def resultArray(self, nums, k, queries):
        n = len(nums)

        # tree[node] = [product_mod_k, counts_of_prefix_products]
        tree = [(1, [0] * k) for _ in range(4 * n)]

        def merge(left, right):
            prod1, cnt1 = left
            prod2, cnt2 = right

            prod = (prod1 * prod2) % k
            cnt = cnt1[:]

            # Prefixes that continue from left into right
            for r in range(k):
                cnt[(prod1 * r) % k] += cnt2[r]

            return prod, cnt

        def build(node, l, r):
            if l == r:
                p = nums[l] % k
                cnt = [0] * k
                cnt[p] = 1
                tree[node] = (p, cnt)
                return

            mid = (l + r) // 2

            build(node * 2, l, mid)
            build(node * 2 + 1, mid + 1, r)

            tree[node] = merge(
                tree[node * 2],
                tree[node * 2 + 1]
            )

        def update(node, l, r, pos, value):
            if l == r:
                p = value % k
                cnt = [0] * k
                cnt[p] = 1
                tree[node] = (p, cnt)
                return

            mid = (l + r) // 2

            if pos <= mid:
                update(node * 2, l, mid, pos, value)
            else:
                update(node * 2 + 1, mid + 1, r, pos, value)

            tree[node] = merge(
                tree[node * 2],
                tree[node * 2 + 1]
            )

        def query(node, l, r, ql, qr):
            if ql <= l and r <= qr:
                return tree[node]

            mid = (l + r) // 2

            if qr <= mid:
                return query(node * 2, l, mid, ql, qr)

            if ql > mid:
                return query(node * 2 + 1, mid + 1, r, ql, qr)

            left = query(node * 2, l, mid, ql, qr)
            right = query(node * 2 + 1, mid + 1, r, ql, qr)

            return merge(left, right)

        build(1, 0, n - 1)

        ans = []

        for index, value, start, x in queries:
            # This update persists for future queries
            update(1, 0, n - 1, index, value)

            # Every possible remaining array is a prefix of
            # nums[start:]
            _, cnt = query(1, 0, n - 1, start, n - 1)

            ans.append(cnt[x])

        return ans

# Shortest Path With At Most K Consecutive Identical CharactersShortest Path With At Most K Consecutive Identical Characters :-

def shortestPath(self, n: int, edges: List[List[int]], labels: str, k: int) -> int:
        adj = [[] for _ in range(n)]

        for u, v, w in edges:
            adj[u].append((v, w))

        INF = float('inf')

        # dist[node][count] = minimum cost to reach node
        # with count consecutive occurrences of labels[node]
        dist = [[INF] * (k + 1) for _ in range(n)]

        # Starting node contributes one character
        dist[0][1] = 0

        # (cost, node, consecutive_count)
        pq = [(0, 0, 1)]

        while pq:
            cost, u, count = heapq.heappop(pq)

            # Ignore outdated heap entries
            if cost != dist[u][count]:
                continue

            # First time reaching destination gives minimum cost
            if u == n - 1:
                return cost

            for v, w in adj[u]:

                if labels[u] == labels[v]:
                    new_count = count + 1
                else:
                    new_count = 1

                # Reject paths exceeding k consecutive characters
                if new_count > k:
                    continue

                new_cost = cost + w

                if new_cost < dist[v][new_count]:
                    dist[v][new_count] = new_cost
                    heapq.heappush(
                        pq, (new_cost, v, new_count)
                    )

        return -1

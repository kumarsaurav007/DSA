# Calculate Digit Sum of a String :-

def digitSum(self, s: str, k: int) -> str:
        while len(s) > k:
            result = []

            for i in range(0, len(s), k):
                group = s[i:i + k]
                total = sum(int(ch) for ch in group)
                result.append(str(total))

            s = ''.join(result)

        return s

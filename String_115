# Lexicographically Smallest Permutation Greater Than Target :-

def lexGreaterPermutation(self, s: str, target: str) -> str:
        n = len(s)

        cnt = [0] * 26
        for ch in s:
            cnt[ord(ch) - ord('a')] += 1

        # We will try making the answer greater at position i.
        # First, consume target characters from left to right.
        used = [0] * 26

        for i in range(n):
            c = ord(target[i]) - ord('a')

            if cnt[c] == 0:
                break

            cnt[c] -= 1
            used[c] += 1

        # Restore everything so we can process from right to left.
        cnt = [0] * 26
        for ch in s:
            cnt[ord(ch) - ord('a')] += 1

        # prefix_ok tells us whether target[:i] can be formed.
        for i in range(n - 1, -1, -1):

            # Remove target[0:i] from available characters.
            temp = cnt[:]

            possible = True

            for j in range(i):
                c = ord(target[j]) - ord('a')

                if temp[c] == 0:
                    possible = False
                    break

                temp[c] -= 1

            if not possible:
                continue

            # At position i, choose smallest character
            # strictly greater than target[i].
            cur = ord(target[i]) - ord('a')

            for c in range(cur + 1, 26):
                if temp[c] > 0:
                    temp[c] -= 1

                    # Prefix equal to target
                    ans = target[:i]

                    # Character that makes it greater
                    ans += chr(c + ord('a'))

                    # Fill remaining positions with smallest characters
                    for d in range(26):
                        ans += chr(d + ord('a')) * temp[d]

                    return ans

        return ""

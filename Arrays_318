# Count Non-Decreasing Subarrays After K Operations :-

class Solution:
    def countNonDecreasingSubarrays(self, nums: List[int], k: int) -> int:
        n = len(nums)

        # Prefix sums
        pref = [0] * (n + 1)
        for i in range(n):
            pref[i + 1] = pref[i] + nums[i]

        # Next greater element
        nxt = [n] * (n + 1)
        stack = []

        for i in range(n):
            while stack and nums[stack[-1]] < nums[i]:
                nxt[stack.pop()] = i
            stack.append(i)

        # Binary lifting tables
        LOG = n.bit_length()

        jump = [[n] * (n + 1) for _ in range(LOG)]
        cost = [[0] * (n + 1) for _ in range(LOG)]

        for i in range(n):
            p = nxt[i]
            jump[0][i] = p
            cost[0][i] = (
                nums[i] * (p - i)
                - (pref[p] - pref[i])
            )

        for j in range(1, LOG):
            for i in range(n):
                mid = jump[j - 1][i]

                jump[j][i] = jump[j - 1][mid]
                cost[j][i] = (
                    cost[j - 1][i] +
                    cost[j - 1][mid]
                )

        # Calculate operations needed for a subarray
        def get_cost(left, right):
            pos = left
            total = 0

            for j in range(LOG - 1, -1, -1):
                p = jump[j][pos]

                if p <= right:
                    total += cost[j][pos]
                    pos = p

            total += (
                nums[pos] * (right - pos + 1)
                - (pref[right + 1] - pref[pos])
            )

            return total

        # Sliding window
        ans = 0
        left = 0

        for right in range(n):
            while get_cost(left, right) > k:
                left += 1

            ans += right - left + 1

        return ans

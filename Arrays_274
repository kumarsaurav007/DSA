# Stone Game V :-

def stoneGameV(self, stoneValue: List[int]) -> int:
        prefix = list(accumulate(stoneValue, initial=0))

        @cache
        def dp(l, r):
            if l >= r:
                return 0

            ans = 0

            left_sum = 0
            right_sum = prefix[r + 1] - prefix[l]

            for i in range(l, r):
                left_sum += stoneValue[i]
                right_sum -= stoneValue[i]

                if left_sum < right_sum:
                    # Bob keeps the left part
                    if ans >= left_sum * 2:
                        continue

                    ans = max(
                        ans,
                        left_sum + dp(l, i)
                    )

                elif left_sum > right_sum:
                    # Bob keeps the right part
                    if ans >= right_sum * 2:
                        break

                    ans = max(
                        ans,
                        right_sum + dp(i + 1, r)
                    )

                else:
                    # Equal sums: Alice can choose either part
                    ans = max(
                        ans,
                        left_sum + dp(l, i),
                        right_sum + dp(i + 1, r)
                    )

            return ans

        return dp(0, len(stoneValue) - 1)

# Find Two Non-overlapping Sub-arrays Each With Target Sum :-

def minSumOfLengths(self, arr: list[int], target: int) -> int:
        n = len(arr)
        INF = float('inf')

        # best[i] = shortest valid subarray ending before index i
        best = [INF] * (n + 1)

        left = 0
        curr = 0
        ans = INF
        min_len = INF

        for right in range(n):
            curr += arr[right]

            while curr > target:
                curr -= arr[left]
                left += 1

            if curr == target:
                length = right - left + 1

                # Combine with a previous non-overlapping subarray
                if best[left] != INF:
                    ans = min(ans, length + best[left])

                min_len = min(min_len, length)

            # Best valid subarray ending before right + 1
            best[right + 1] = min_len

        return -1 if ans == INF else ans

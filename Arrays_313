# Count Zero Request Servers :-

def countServers(self, n: int, logs: List[List[int]], x: int, queries: List[int]) -> List[int]:
        logs.sort(key=lambda log: log[1])

        # Keep original query indices so we can return answers
        # in the order the queries were given.
        sorted_queries = sorted(
            (query, i) for i, query in enumerate(queries)
        )

        freq = [0] * (n + 1)
        active_servers = 0

        left = 0
        right = 0
        result = [0] * len(queries)

        for query, idx in sorted_queries:
            start_time = query - x

            # Add logs whose time is <= query
            while right < len(logs) and logs[right][1] <= query:
                server_id = logs[right][0]

                if freq[server_id] == 0:
                    active_servers += 1

                freq[server_id] += 1
                right += 1

            # Remove logs whose time is < start_time
            while left < right and logs[left][1] < start_time:
                server_id = logs[left][0]

                freq[server_id] -= 1

                if freq[server_id] == 0:
                    active_servers -= 1

                left += 1

            result[idx] = n - active_servers

        return result

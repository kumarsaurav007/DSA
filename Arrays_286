# Unique 3-Digit Even Numbers :-

def totalNumbers(self, digits: List[int]) -> int:
        count = Counter(digits)
        ans = 0

        for num in range(100, 1000, 2):
            a = num // 100
            b = (num // 10) % 10
            c = num % 10

            need = Counter([a, b, c])

            if all(need[d] <= count[d] for d in need):
                ans += 1

        return ans
